<?xml version="1.0" encoding="utf-8"?>
<!-- the folders OpenFileProvider can serve. a file is copied into open/ or
     share/ when the person opens or shares it with another app, and
     shredded once it is a few minutes old, an open one also on a lock. the
     app's own media folder is never reachable from outside. -->
<paths>
    <cache-path name="open" path="open/" />
    <cache-path name="share" path="share/" />
    <cache-path name="tools_out" path="tools_out/" />
</paths>
