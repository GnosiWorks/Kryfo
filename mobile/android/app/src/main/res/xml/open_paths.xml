<?xml version="1.0" encoding="utf-8"?>
<!-- the folders OpenFileProvider can serve. a file is copied into open/,
     share/ or share_q/ (shared from a hidden chat or the decoy) when the
     person opens or shares it with another app, and shredded once it is a
     few minutes old. a backup goes to backup_out/,
     kept until the next one or a day. the app's own media folder is never
     reachable from outside. -->
<paths>
    <cache-path name="open" path="open/" />
    <cache-path name="share" path="share/" />
    <cache-path name="share_q" path="share_q/" />
    <cache-path name="backup_out" path="backup_out/" />
    <cache-path name="tools_out" path="tools_out/" />
</paths>
