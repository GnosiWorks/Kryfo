<?xml version="1.0" encoding="utf-8"?>
<!-- chats in the share menu (ShareTargets.kt): one share-target per entry,
     since only the icon in use is enabled -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="app.kryfo.MainActivity">
        <data android:mimeType="text/plain" />
        <data android:mimeType="image/*" />
        <data android:mimeType="video/*" />
        <data android:mimeType="audio/*" />
        <data android:mimeType="application/*" />
        <category android:name="app.kryfo.category.SHARE_CHAT" />
    </share-target>
    <share-target android:targetClass="app.kryfo.IconNotes">
        <data android:mimeType="text/plain" />
        <data android:mimeType="image/*" />
        <data android:mimeType="video/*" />
