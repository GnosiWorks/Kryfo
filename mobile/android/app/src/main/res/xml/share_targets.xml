        <data android:mimeType="audio/*" />
        <data android:mimeType="application/*" />
        <category android:name="app.kryfo.category.SHARE_CHAT" />
    </share-target>
    <share-target android:targetClass="app.kryfo.IconTasks">
        <data android:mimeType="text/plain" />
