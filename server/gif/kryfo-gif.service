[Unit]
Description=Kryfo gif relay
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/opt/kryfo-gif/kryfo-gif
Environment=GIF_ADDR=127.0.0.1:3338
# read by systemd as root before the service starts: the files stay root 600
# and the service never opens them. a missing provider file is skipped
EnvironmentFile=-/etc/kryfo-gif/giphy.env
EnvironmentFile=-/etc/kryfo-gif/klipy.env
EnvironmentFile=/etc/kryfo-gif/secret.env
Restart=always
RestartSec=3
DynamicUser=yes
# logs to ram only, same posture as the relay
StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
MemoryMax=256M
TasksMax=256

[Install]
WantedBy=multi-user.target
