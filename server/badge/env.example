# what the badge service reads from its environment. copy to a file only
# root and the service user can read, and point the unit's EnvironmentFile
# at it. nothing here has a usable default on purpose: the service refuses
# to start without the two btcpay values.
#
# this file is an example and holds no real value. the real one is never
# committed, and neither is badge.key (*.key is in .gitignore).

# greenfield api key, scoped to the one store, with only:
#   btcpay.store.cancreateinvoice  btcpay.store.canviewinvoices
BTCPAY_APIKEY=
BTCPAY_STOREID=

# where btcpay answers from this box
BTCPAY_URL=http://127.0.0.1

# where this service listens. tor's HiddenServicePort points here
BADGE_ADDR=127.0.0.1:8899

# invoices an hour, from everyone together. every invoice costs btcpay a
# fresh address, paid or not, and a flood of them walks the wallet past its
# gap limit: a restore from seed then misses addresses real money went to.
BADGE_INVOICES_PER_HOUR=30

# unpaid invoices in a row before new ones are held. a wallet restored from
# seed looks 20 addresses past the last paid one; 15 leaves room. a payment
# opens it again. raise it only with the wallet's own gap limit.
BADGE_GAP_LIMIT=15

# invoices made before this time are not counted (RFC 3339, e.g.
# 2026-11-01T12:00:00Z). set it only once the wallet is known to see every
# address up to then. empty counts them all.
BADGE_GAP_SINCE=

# the ed25519 key receipts are signed with. made on first start if missing.
# the public half is compiled into the app (kBadgePubKeyB64 in
# mobile/lib/badge_client.dart): lose this file and every badge ever issued
# stops verifying. it is backed up; CONTINUITY says where.
BADGE_KEY=/opt/halo-badge/badge.key
