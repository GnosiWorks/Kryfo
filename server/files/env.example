# /etc/kryfo-files/limits.env, root 600. every value has this default
FILES_MAX_MB=50
FILES_FLOOR_GB=5
# what all files together may hold, 0: only the disk and the floor
FILES_QUOTA_GB=0
# everyone together, a day: bytes that came in, files begun
FILES_DAY_GB=150
FILES_DAY_FILES=20000
# a file that sends no part for this long lets its room go
FILES_IDLE_MIN=15
# records kept, and files still coming, at most
FILES_MAX_FILES=50000
FILES_MAX_COMING=500
FILES_KEEP_DAYS=7
# work per upload: this many bits under 1 MB, one more each doubling
FILES_POW_BASE=18
