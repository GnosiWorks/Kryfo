# /etc/kryfo-files/limits.env, root 600. every value has this default
FILES_MAX_MB=50
FILES_FLOOR_GB=5
# what all files together may hold, 0: only the disk and the floor
FILES_QUOTA_GB=0
# everyone together: bytes that came in today, files begun in the last hour
FILES_DAY_GB=150
FILES_HOUR_FILES=1500
# files every recipient has, kept their week so a resend uploads nothing
FILES_MAX_DELIVERED=200000
# a file that sends no part for this long lets its room go
FILES_IDLE_MIN=15
# records kept at most (memory); bytes still coming at which work rises
FILES_MAX_FILES=50000
FILES_MAX_COMING_GB=20
FILES_KEEP_DAYS=7
# work per new upload: this many bits under 1 MB, one more each doubling,
# at most the cap; past half of any cap, one more bit each tenth over
FILES_POW_BASE=16
FILES_POW_CAP=20
