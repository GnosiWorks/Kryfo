# what the paid service reads from its environment. the real file is
# /etc/kryfo-paid/paid.env, root 600, read by systemd before the service
# starts. this one is an example and holds no real value.

# greenfield api key for this service alone, scoped to the one store, with
# only btcpay.store.canviewinvoices. not the badge key
BTCPAY_APIKEY=
BTCPAY_STOREID=

# where btcpay answers from this box
BTCPAY_URL=http://127.0.0.1

# the webhook's secret, as in btcpay's webhook form. 16 characters or more
PAID_WEBHOOK_SECRET=

# an ntfy topic url. the topic is the only secret: make it long and random
NTFY_URL=

# 1 sends pushes over ipv4 only: ntfy.sh counts a whole ipv6 /64 as one
# sender, and a hosting provider's /64 can be over its limit already
NTFY_IPV4=1
