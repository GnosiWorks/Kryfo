# BRIDGE_ADDR is the docker network address the other bridges bind; the
# install script fills it in from halo-relay-bridge.
# Wants, not BindsTo: BindsTo stops the bridge with the service and never
# starts it again
[Unit]
Description=Kryfo donation pushes bridge for btcpay's container
After=network-online.target docker.service kryfo-paid.service
Wants=kryfo-paid.service

[Service]
ExecStart=/usr/bin/socat TCP-LISTEN:3341,bind=BRIDGE_ADDR,fork,reuseaddr,max-children=16 TCP:127.0.0.1:3340,connect-timeout=5
Restart=always
RestartSec=3
DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
StandardOutput=null
MemoryMax=32M
TasksMax=24

[Install]
WantedBy=multi-user.target
