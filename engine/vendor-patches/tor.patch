+  if (!circ->cpath || circ->cpath->state != CPATH_STATE_AWAITING_KEYS ||
+      circ->base_.received_destroy || !chan || !CHANNEL_IS_OPEN(chan) ||
+      channel_is_bad_for_new_circs(chan)) {
